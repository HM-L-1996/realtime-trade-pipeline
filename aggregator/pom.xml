<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.rtp</groupId>
    <artifactId>realtime-trade-pipeline</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>aggregator</artifactId>

  <dependencies>
    <dependency>
      <groupId>dev.rtp</groupId>
      <artifactId>common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      Flink 코어는 provided 다. 클러스터가 이미 갖고 있으므로 잡 jar 에 넣으면
      클래스 로딩이 충돌한다.
    -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- 커넥터는 클러스터에 없으므로 잡 jar 에 포함한다. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${flink.kafka.connector.version}</version>
    </dependency>
    <!-- 로깅 구현체는 Flink 클러스터가 갖고 있다. jar 에 넣으면 충돌한다. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- ClickHouse 적재는 JDBC 드라이버 없이 HTTP 인터페이스를 직접 쓴다.
         clickhouse-jdbc 를 fat jar 에 넣으면 셰이딩 충돌이 잦고,
         여기서는 배치·플러시·재시도가 명시적으로 보이는 편이 낫다. -->

    <!--
      Iceberg 싱크. ClickHouse 싱크와 나란히 달아 exactly-once 와 at-least-once 를
      같은 입력으로 비교하기 위한 것이다. Iceberg 싱크는 체크포인트에 맞춰
      스냅샷을 커밋하므로 장애 시 커밋되지 않은 데이터가 버려진다 -
      ClickHouse 싱크는 재처리분이 그대로 다시 쓰인다.
    -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-flink-runtime-1.20</artifactId>
      <version>${iceberg.version}</version>
    </dependency>

    <!--
      RowData / DecimalData / TimestampData 를 쓰기 위한 것이다.
      Flink 배포본의 /opt/flink/lib 에 flink-table-runtime 이 이미 있으므로
      provided 로 둔다 - fat jar 에 넣으면 런타임에 클래스가 두 벌이 된다.
    -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-common</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <!--
      S3(MinIO) 접근에 hadoop-aws 를 쓰지 않는다. Hadoop 을 끌어오면 fat jar 이
      384MB 가 되고(실측) 클래스 로딩 충돌 위험도 커진다.
      Iceberg 자체 S3FileIO + AWS SDK v2 번들이면 Hadoop 없이 된다.
    -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws-bundle</artifactId>
      <version>${iceberg.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-test-utils</artifactId>
      <version>${flink.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-runtime</artifactId>
      <version>${flink.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.rtp.aggregator.CandleJob</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
